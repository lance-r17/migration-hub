DATABASE_URL=postgresql+asyncpg://hub:hub_dev_secret@localhost/migration_hub
CORS_ORIGINS=http://localhost:5173
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_PROJECT_KEY=MIG
# Issue type ID for subtasks (preferred — find in Jira project settings → Issue Types)
JIRA_SUBTASK_ISSUE_TYPE_ID=
# Fallback name when ID not set (default: Subtask)
JIRA_SUBTASK_ISSUE_TYPE=Subtask
CURRENT_USER_ID=u2
ENVIRONMENT=development

# --- Mock OIDC / dex ---
# Bcrypt hash for mock user passwords (dex staticPasswords).
# Default is a publicly known dev-only hash. Generate a new one with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'<pw>', bcrypt.gensalt()).decode())"
# MOCK_DEX_PASSWORD_HASH=

# --- Standard OIDC (legacy dex/Azure AD flow) ---
# Uncomment these to use the standard OIDC flow.
OIDC_ISSUER=http://localhost:5556/dex
OIDC_AUDIENCE=migration-hub

# --- Custom Enterprise OAuth (NEW) ---
# Uncomment these to use the custom OAuth flow (replaces OIDC).
# Must match the frontend VITE_OAUTH_SERVICE_URL.
# OAUTH_SERVICE_URL=http://localhost:5557
# OAUTH_CLIENT_ID=migration-hub
# OAUTH_CLIENT_SECRET=mock-secret-do-not-use-in-production
# SESSION_SECRET_KEY=change-me-in-production
# SESSION_MAX_AGE_MINUTES=480

# AD group filtering for project auto-assignment
# Regex must contain a capture group for the project_id
# OAUTH_AD_GROUP_REGEX=CN=([^,]+)-ResourceSetReadOnly
# Substring that must be present in the member_of DN
# OAUTH_AD_GROUP_OU_FILTER=OU=Ali

# AD group → global role mapping (JSON array)
# Example: [{"regex":"CN=.*-AdminGroup,OU=Ali","role":"admin"},{"regex":"CN=.*-MigrationLead,OU=Ali","role":"platform_migration_lead"}]
# OAUTH_ROLE_MAPPINGS=
