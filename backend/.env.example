DATABASE_URL=postgresql+asyncpg://hub:hub_dev_secret@localhost/migration_hub
CORS_ORIGINS=http://localhost:5173
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_PROJECT_KEY=MIG
JIRA_API_VERSION=3
# Issue type ID for subtasks (preferred — find in Jira project settings → Issue Types)
JIRA_SUBTASK_ISSUE_TYPE_ID=
# Fallback name when ID not set (default: Subtask)
JIRA_SUBTASK_ISSUE_TYPE=Subtask
CURRENT_USER_ID=u2
ENVIRONMENT=development

# --- Mock OIDC / dex ---
# Bcrypt hash for mock user passwords (dex staticPasswords).
# Default is a publicly known dev-only hash. Generate a new one with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'<pw>', bcrypt.gensalt()).decode())"
# MOCK_DEX_PASSWORD_HASH=

# --- Standard OIDC (legacy dex/Azure AD flow) ---
# Uncomment these to use the standard OIDC flow.
OIDC_ISSUER=http://localhost:5556/dex
OIDC_AUDIENCE=migration-hub

# --- Custom Enterprise OAuth (NEW) ---
# Uncomment these to use the custom OAuth flow (replaces OIDC).
# Must match the frontend VITE_OAUTH_SERVICE_URL.
# OAUTH_SERVICE_URL=http://localhost:5557
# OAUTH_CLIENT_ID=migration-hub
# OAUTH_CLIENT_SECRET=mock-secret-do-not-use-in-production
# SESSION_SECRET_KEY=change-me-in-production
# SESSION_MAX_AGE_MINUTES=480

# AD group filtering for project auto-assignment
# Regex must contain a capture group for the project_id
# OAUTH_AD_GROUP_REGEX=CN=([^,]+)-ResourceSetReadOnly
# Substring that must be present in the member_of DN
# OAUTH_AD_GROUP_OU_FILTER=OU=Ali

# Flexible AD group → project mapping (JSON array, optional)
# Overrides OAUTH_AD_GROUP_REGEX when set. Each entry is {"regex": "...", "project_id": "..."}
# project_id supports capture group substitution with $1, $2, etc.
# Example: [{"regex": "CN=([^,]+)-dev-ResourceSetReadOnly", "project_id": "$1-prod"}]
# OAUTH_AD_GROUP_MAPPINGS=

# AD group → global role mapping (JSON array)
# Example: [{"regex":"CN=.*-AdminGroup,OU=Ali","role":"admin"},{"regex":"CN=.*-MigrationLead,OU=Ali","role":"platform_migration_lead"}]
# OAUTH_ROLE_MAPPINGS=

# --- SMTP / Email sending ---
# Uncomment and fill these in to enable real email delivery from the backend.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Migration Hub <your@gmail.com>
#
# Set to true to print emails to the backend log instead of sending via SMTP.
# Useful for development when you don't have an SMTP server.
# CONSOLE_EMAIL=true

# --- Confluence integration ---
# Cloud:     CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
# DC/Server: CONFLUENCE_BASE_URL=https://confluence.company.com
# CONFLUENCE_AUTH_TYPE=basic        # 'basic' (default) or 'bearer' (DC Personal Access Token)
# CONFLUENCE_API_TOKEN=             # Cloud: API token | DC basic: password | DC bearer: PAT
# CONFLUENCE_USER_EMAIL=            # Required for basic auth only; not used for bearer
# CONFLUENCE_SPACE_KEY=

# --- Email template branding ---
# Platform name and URL used in predefined email template footers.
# PLATFORM_NAME=Migration Engine
# PLATFORM_URL=https://migration-hub.company.com
# EMAIL_BANNER_URL=/email-banner.png

# --- New project ID mapping validation ---
# Optional regex that new project IDs must match when saving via applicationOverview.newProjectId.
# Leave empty to skip validation.
# NEW_PROJECT_ID_REGEX=^[A-Z0-9][A-Z0-9-]{0,62}[A-Z0-9]$

