# SMTP configuration for sending test emails.
# Copy this file to .env and fill in your credentials.
#
# Gmail example:
#   1. Enable 2-factor auth on your Google account
#   2. Generate an App Password: myaccount.google.com/apppasswords
#   3. Use that App Password as SMTP_PASS (not your regular password)
#
# Other providers: Outlook (smtp.office365.com:587), SendGrid (smtp.sendgrid.net:587), etc.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Migration Hub <your@gmail.com>

# Port the email server listens on
# NOTE: This standalone email server is deprecated. Email sending is now handled
# by the backend API via aiosmtplib. Configure SMTP in backend/.env instead.
PORT=3001
