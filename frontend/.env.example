# Base URL for the Migration Hub API.
# Leave empty (or unset) to use mock data — the default for local development.
# Set to the backend URL to switch all service calls to the real API.
#
# Example:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# URL of the local email server (email-server/).
# Set this to enable real email sending from the "Send Test" button.
# Start the server with: cd email-server && npm install && npm run dev
VITE_EMAIL_SERVER_URL=http://localhost:3001

# OIDC / Enterprise SSO configuration.
# Set these to enable the mock OIDC auth flow (via dex). Leave empty for mock auth mode.
# Start dex with: cd backend && docker compose up dex
#
# VITE_OIDC_ISSUER=http://localhost:5556/dex
# VITE_OIDC_CLIENT_ID=migration-hub
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
