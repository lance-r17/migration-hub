# Comma-separated list of hosts allowed by the Vite dev server.
# Leave empty to allow none (default []).
#
# Example:
#   VITE_ALLOWED_HOSTS=example.com,.example.com
VITE_ALLOWED_HOSTS=

# Base URL for the Migration Hub API.
# Leave empty (or unset) to use mock data — the default for local development.
# Set to the backend URL to switch all service calls to the real API.
#
# Example:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# URL of the local email server (email-server/).
# Set this to enable real email sending from the "Send Test" button.
# Start the server with: cd email-server && npm install && npm run dev
VITE_EMAIL_SERVER_URL=http://localhost:3001

# ─── Custom Enterprise OAuth (NEW) ───
# Set these to enable the custom OAuth flow via the mock OAuth service.
# This replaces the standard OIDC flow and matches the real enterprise auth.
# Start the mock service with: cd backend && docker compose up mock-oauth
#
# VITE_OAUTH_SERVICE_URL=http://localhost:5557
# VITE_OAUTH_CLIENT_ID=migration-hub
# VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback

# ─── Standard OIDC (legacy dex/Azure AD flow) ───
# Set these to enable the standard OIDC auth flow (via dex).
# Leave empty (along with VITE_OAUTH_SERVICE_URL) for mock auth mode.
# Start dex with: cd backend && docker compose up dex
#
# VITE_OIDC_ISSUER=http://localhost:5556/dex
# VITE_OIDC_CLIENT_ID=migration-hub
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
