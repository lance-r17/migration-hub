# Nexus Docker Registry Configuration
# Copy this file to .env.nexus and fill in your actual values.
#
# The frontend supports RUNTIME configuration only.
# Pass env vars to `docker run` (e.g. API_BASE_URL). The container's
# Go entrypoint binary injects them into index.html as window.__ENV__
# before starting nginx. No rebuild needed when changing environments.
# Works in distroless images that have no shell.
#
# -----------------------------------------------------------------------------
# Docker base images (both configurable)
# -----------------------------------------------------------------------------

# Build-stage base image — must have Node.js 20+ and npm.
#   Must match the C library of RUNTIME_IMAGE. gcr.io/distroless/base is glibc,
#   so use a Debian-based builder (node:20-slim) rather than Alpine.
BUILD_IMAGE=node:20-slim

# Go build-stage base image — must have Go 1.22+.
#   Use an internal mirror if you cannot pull from Docker Hub, e.g.:
#   GO_BUILD_IMAGE=your-registry/golang:1.22-alpine
GO_BUILD_IMAGE=golang:1.22-bookworm

# Runtime base image — any image compatible with the builder's C library.
#   musl (Alpine builder): nginx:alpine, cgr.dev/chainguard/nginx, your Alpine distroless-base
#   glibc (Debian builder): gcr.io/distroless/cc, gcr.io/distroless/base
RUNTIME_IMAGE=gcr.io/distroless/base

# -----------------------------------------------------------------------------
# Runtime environment variables (read by the Go entrypoint binary)
# These DO NOT require a rebuild. Set them when running the container.
# -----------------------------------------------------------------------------

API_BASE_URL=
# EMAIL_SERVER_URL=
# OAUTH_SERVICE_URL=
# OAUTH_CLIENT_ID=
# OAUTH_REDIRECT_URI=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Nexus registry target
# -----------------------------------------------------------------------------

# Nexus server hostname (without protocol, without port if using standard 443)
# Example: nexus.company.com or nexus.company.com:8443
NEXUS_HOST=nexus.company.com

# Nexus Docker repository name (the hosted docker repository in Nexus)
# Example: docker-hosted
NEXUS_REPO=docker-hosted

# Optional: namespace/path within the repository
# Example: migration-hub
NEXUS_NAMESPACE=migration-hub

# Image name component
IMAGE_NAME=frontend

# Image tag (default: latest)
# Can be overridden with IMAGE_TAG env var or auto-generated from git short sha
IMAGE_TAG=latest

# Optional: Nexus credentials for docker login
# If not provided, the script assumes you are already logged in (via docker login)
# NEXUS_USERNAME=your-username
# NEXUS_PASSWORD=your-password
